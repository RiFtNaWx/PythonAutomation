{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Push to GitHub",
      "type": "shell",
      "windows": {"command": "${workspaceFolder}/Github_Auto/git-push.bat"},
      "osx":     {"command": "bash ${workspaceFolder}/Github_Auto/git-push.sh"},
      "linux":   {"command": "bash ${workspaceFolder}/Github_Auto/git-push.sh"},
      "group": {"kind": "build", "isDefault": false},
      "presentation": {"reveal": "always", "panel": "new", "focus": true},
      "problemMatcher": []
    },
    {
      "label": "Launch push button",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "push_button.bat"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "type": "process",
        "command": "cmd.exe",
        "args": ["/d", "/c", "push_button.bat"],
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      "osx": {
        "type": "process",
        "command": "${workspaceFolder}/venv/bin/pythonw",
        "args": ["Github_Auto/push_button.pyw"],
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      "linux": {
        "type": "process",
        "command": "${workspaceFolder}/venv/bin/pythonw",
        "args": ["Github_Auto/push_button.pyw"],
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "close": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Auto-pull on open (ff-only, skip if dirty)",
      "type": "shell",
      "windows": {
        "command": "if (Test-Path venv\\Scripts\\python.exe) { venv\\Scripts\\python.exe -m ate.core.sync_repo } else { python -m ate.core.sync_repo }"
      },
      "osx": {
        "command": "if [ -x venv/bin/python ]; then venv/bin/python -m ate.core.sync_repo; else python3 -m ate.core.sync_repo; fi"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "close": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
